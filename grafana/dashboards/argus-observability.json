    {
      "id": 11,
      "type": "timeseries",
      "title": "Heap used vs max",
      "description": "Heap in use against the configured maximum. Used approaching max means GC pressure and a coming OOM exit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"argus\",area=\"heap\"})",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "used"
